target
.gemini
# The agent tool's own scratch directory, at the repo root only. Both
# patterns must be anchored: an unanchored `superpowers` also matched
# docs/superpowers/, which silently kept the grove delivery plan and the
# phase-0 baseline out of the repo even though six documents link to them.
/superpowers/
/.superpowers/

.DS_Store
.venv/
__pycache__/
*.pt

# Local agent/tooling config. `AGENTS.md` and `CLAUDE.md` are anchored to
# the root so they cannot match a nested module's own copy, and
# `.agents/skills/*` is ignored *except* the `architect` skill the repo
# already tracks.
/AGENTS.md
/CLAUDE.md
/.claude/
/.agents/skills/*
!/.agents/skills/architect/

# Astro build output and deps. apps/site/public/wasm is deliberately tracked:
# the committed wasm bundle is what the page loads (tools/build-wasm.sh).
apps/site/node_modules/
apps/site/dist/
apps/site/.astro/
