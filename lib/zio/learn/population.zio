;; ── zio.learn.population — allocation policy, pure ─────────────────
;; The Zio side of W09: given branch summaries (quality, cost, pairwise
;; divergence), propose what a population keeps, pauses and kills under
;; its quotas. The coordinator enforces the proposal against the ledger;
;; this module never touches storage, processes or money.

;; Branch summaries arrive as data:
;;   {:id … :quality 0.91 :accuracy-bp 9100 :divergence 0.42 :baseline? true}

(defn population--sorted-by-accuracy [branches]
  (sort (fn [a b] (> (get (get a :metrics nil) :accuracy-bp 0)
                     (get (get b :metrics nil) :accuracy-bp 0)))
        branches))

(defn population--is-baseline? [b]
  (get b :baseline false))

(defn population--divergence [a b]
  ;; reported by the caller: 0 = identical behavior, 1 = complementary
  (let [ka (get a :id nil) kb (get b :id nil)]
    (if (= ka kb) 0 (get a :divergence-to-b 0))))

;; ── the proposal ───────────────────────────────────────────────────
;; Quotas: the population must keep
;;   * the baseline (the reference every candidate is measured against),
;;   * the accuracy leader,
;;   * `explore-quota` branches that are maximally divergent from what is
;;     already kept — diversity is a quota, not a leftover.
;; Everything else is proposed for pausing (never deletion: history is
;; the point).

(defn population--propose [branches explore-quota]
  (let* [sorted (population--sorted-by-accuracy branches)
         ;; 1. the baseline is kept unconditionally, however it scores
         kept-baseline (filter population--is-baseline? branches)
         rest (filter (fn [b] (not (population--is-baseline? b))) sorted)
         ;; 2. the accuracy leader among the rest
         leader (first rest)
         rest2 (if (nil? leader) [] (rest rest))
         ;; 3. exploration: greedily keep the branch most divergent from
         ;;    everything already kept, until the quota is filled
         explore (loop [pool rest2 kept []]
                   (if (or (>= (count kept) explore-quota) (empty? pool))
                     kept
                     (let* [most-div (first
                                      (sort (fn [x y] (> (get x :min-divergence 0)
                                                         (get y :min-divergence 0)))
                                            pool))]
                       (recur
                        (filter (fn [b] (not= (get b :id nil) (get most-div :id nil))) pool)
                        (cons most-div kept)))))]
    {:keep (into (into (into [] kept-baseline)
                       (if (nil? leader) [] [leader]))
                 explore)
     :pause (let [kept-ids (set-of-ids (into (into [] kept-baseline)
                                             (if (nil? leader) [] [leader])))]
              (filter (fn [b] (not (contains-id? kept-ids (get b :id nil)))) branches))}))

(defn set-of-ids [branches]
  (reduce (fn [acc b] (put acc (get b :id nil) true)) {} branches))

(defn contains-id? [ids id]
  (get ids id false))

;; ── budget policy ──────────────────────────────────────────────────
;; New work needs `requested` steps; the population grants from one
;; shared ledger. When the grant cannot cover it, the proposal is to
;; pause at safe points — not to shrink a running run mid-step.

(defn population--can-start? [spent total requested]
  (<= (+ spent requested) total))

(defn population--safe-pause [branches spent total]
  ;; propose pausing the LOWEST-accuracy running branches first, until the
  ;; outstanding debt fits the remaining grant
  (let* [remaining (- total spent)
         sorted (sort (fn [a b] (< (get (get a :metrics nil) :accuracy-bp 0)
                                   (get (get b :metrics nil) :accuracy-bp 0)))
                      branches)]
    (loop [pool sorted paused [] debt 0]
      (if (empty? pool)
        {:pause paused :outstanding debt}
        (let* [b (first pool)
               debt2 (+ debt (get b :running-steps 0))]
          (if (> debt2 remaining)
            (recur (rest pool) (cons b paused) debt2)
            (recur (rest pool) paused debt2)))))))

(println "zio.learn.population loaded (baseline+leader+diversity quotas, shared-ledger budget policy; pure)")
