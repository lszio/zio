;; ── zio.agent — Agent Orchestration Framework ────────────────────
;; Agent orchestration, tool execution, and memory loop in pure Zio Lisp.

(defn make-agent [name system-prompt tools]
  {:agent/name name
   :agent/system-prompt system-prompt
   :agent/tools tools
   :agent/history []
   :agent/status :idle})

(defn register-tool [agent tool-name tool-fn]
  (let [tools (get agent :agent/tools {})
        updated-tools (put tools tool-name tool-fn)]
    (assoc agent :agent/tools updated-tools)))

(defn step [agent input-msg]
  (let [history (get agent :agent/history [])
        user-msg {:role "user" :content input-msg}
        new-history (vector-conj history user-msg)
        response {:role "assistant" :content (str "Agent [" (get agent :agent/name) "] executed: " input-msg)}]
    (assoc agent
           :agent/history (vector-conj new-history response)
           :agent/status :active)))

(defn run [agent task-prompt]
  (let [result-agent (step agent task-prompt)
        history (get result-agent :agent/history [])
        last-msg (peek history)]
    (get last-msg :content)))

(println "zio.agent loaded — fully functional Agent MVP")
