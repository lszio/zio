;; ── zio.datalog — Datalog storage (transact) ────────────────────
;; Datomic-style datom storage in pure Zio Lisp.
;;
;; Status: create-db and transact are runnable (tx-data must be a
;; list of lists — car/cdr require lists). The query evaluator is a
;; STUB: q ignores its query form and returns datom values; there is
;; no unification, join, or rule recursion yet. match-clause below is
;; the intended foundation for single-clause matching. See the
;; feature matrix before relying on this library.

(defn create-db [& schema]
  {:datalog/datoms []})

(defn transact [db tx-data]
  (loop [items tx-data curr-db db]
    (if (or (nil? items) (= (count items) 0))
      curr-db
      (let* [item (car items)
             e (get item 0)
             a (get item 1)
             v (get item 2)
             op (get item 3 :db/add)
             new-datom [e a v op]
             old-datoms (get curr-db :datalog/datoms [])
             updated-db (assoc curr-db :datalog/datoms (vector-conj old-datoms new-datom))]
        (recur (cdr items) updated-db)))))

(defn match-clause [datoms clause]
  (let [pattern-e (get clause 0)
        pattern-a (get clause 1)
        pattern-v (get clause 2)]
    (filter (fn [d]
              (let [e (get d 0)
                    a (get d 1)
                    v (get d 2)]
                (and (if (symbol? pattern-e) true (= pattern-e e))
                     (if (symbol? pattern-a) true (= pattern-a a))
                     (if (symbol? pattern-v) true (= pattern-v v)))))
            datoms)))

(defmacro q [query-form db]
  ;; Stub: the query form is accepted but not evaluated (Planned).
  (list 'datalog-q-stub (list 'quote query-form) db))

(defn datalog-q-stub [query db]
  ;; Placeholder result so callers can see the shape; ignores query.
  (map (fn [d] [(get d 2)]) (get db :datalog/datoms [])))

(println "zio.datalog loaded (transact runnable; query evaluator is a stub — Planned)")
