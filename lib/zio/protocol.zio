;; ── zio.protocol — Protocol system (on ZOS generic functions) ───
;; Clojure-style protocols: (defprotocol Name (method [args])) and
;; (extend-type Type Protocol (method [this & args] body)).
;;
;; Status: Experimental. Both macros are runnable; methods dispatch
;; through the ZOS generic function machinery.

(defmacro defprotocol [name & sigs]
  (let [gf-forms (map (fn [sig]
                        (let [fname (car sig)
                              fnargs (car (cdr sig))]
                          (list 'defgeneric fname fnargs)))
                      sigs)]
    (cons 'do gf-forms)))

(defmacro extend-type [type-name protocol-name & method-impls]
  (let [method-forms (map (fn [impl]
                            ;; let* : spec-args depends on first-arg/rest-args.
                            ;; fnargs is normalized to a list first — car/cdr
                            ;; and cons operate on lists, not vectors.
                            (let* [fname (car impl)
                                   fnargs (apply list (car (cdr impl)))
                                   body (cdr (cdr impl))
                                   first-arg (car fnargs)
                                   rest-args (cdr fnargs)
                                   spec-args (cons (list first-arg type-name) rest-args)]
                              (cons 'defmethod (cons fname (cons spec-args body)))))
                          method-impls)]
    (cons 'do method-forms)))
