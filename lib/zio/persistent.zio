;; ── zio.persistent — Persistent (immutable) collections ─────────
;; Immutable operations built on Zio's persistent im::Vector and im::HashMap.

(defn conj [coll x]
  (if (vector? coll)
    (vector-conj coll x)
    (if (map? coll)
      (put coll (car x) (car (cdr x)))
      (cons x coll))))

(defn pop [coll]
  (if (vector? coll)
    (slice coll 0 (dec (count coll)))
    (if (list? coll)
      (cdr coll)
      coll)))

(defn peek [coll]
  (if (vector? coll)
    (get coll (dec (count coll)))
    (if (list? coll)
      (car coll)
      nil)))

(defn merge [& maps]
  (reduce (fn [acc m]
            (if (map? m)
              (reduce (fn [a k] (put a k (get m k))) acc (keys m))
              acc))
          {} maps))

(defn set [& items]
  (reduce (fn [acc item] (put acc item true)) {} items))

(defn contains? [s item]
  (if (map? s)
    (not (nil? (get s item)))
    false))

(defn disj [s item]
  (if (map? s)
    (remove s item)
    s))

(println "zio.persistent loaded — fully functional")
