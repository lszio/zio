;; ── zio.entity — Entity model (identity + metadata) ─────────────
;;
;; Status: Experimental. defentity / make-entity / entity-id runnable.
;; Entity ids are buffers rendered as strings — real unique identity
;; awaits an identity primitive in core.

(defmacro defentity [name fields]
  (let [entity-class-name (symbol (str "entity-" name))]
    (list 'defclass entity-class-name nil
          (map (fn [f] (list f :initarg (keyword f))) fields))))

(defn make-entity [type-sym & kvs]
  ;; defentity names the class "entity-<type>"; use the same name here.
  (let* [cls (symbol (str "entity-" (str type-sym)))
         inst (apply make-instance (cons cls kvs))
         id (str "entity-" (str type-sym) "-" (str (bytes 8)))]
    {:entity/type type-sym
     :entity/id id
     :entity/instance inst}))

(defn entity-id [entity]
  (if (map? entity)
    (get entity :entity/id)
    nil))
