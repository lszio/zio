{
  "version": 2,
  "name": "zio-landing-site",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/site/index.html" },
    { "source": "/agent", "destination": "/site/agent/index.html" },
    { "source": "/grove", "destination": "/site/grove/index.html" },
    { "source": "/site/(.*)", "destination": "/site/$1" },
    { "source": "/(.*)", "destination": "/site/$1" }
  ]
}
