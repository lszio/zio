{
  "version": 2,
  "name": "zio-landing-site",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/grove", "destination": "/grove/index.html" },
    { "source": "/agent", "destination": "/agent/index.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
