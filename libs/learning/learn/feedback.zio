;; ── zio.learn.feedback — signal policy and frozen data views ───────
;; Pure policy: given the signals a producer submitted, decide what a
;; training view may contain. The host (`grove`) owns persistence,
;; permission and transactions; nothing here reads the current model
;; head, because feedback always binds to the exact prediction it
;; corrects — never to "whatever is deployed now".
;;
;; Policy rules (self-learning-architecture §4.4):
;;   1. a correction applies to its target field only;
;;   2. an authorized human correction outranks a teacher pseudo-label
;;      on the same target;
;;   3. two human corrections that disagree are *conflicts* — neither
;;      wins until a human adjudicates; last write never wins;
;;   4. abstain is an answer, not a negative label;
;;   5. a retraction changes the next view, never a frozen one.
;;
;; Everything is a pure function of its arguments: same signals, same
;; view, every time.

(def feedback--field (fn [s] (get s :target-field nil)))

(defn feedback--human? [s]
  (let [k (get s :kind nil)]
    (or (= k :human-correction) (= k :human-preference) (= k :demonstration))))

(defn feedback--teacher? [s]
  (= (get s :kind nil) :teacher-label))

;; A retracted or superseded signal leaves the pool; the host records
;; the status, and this layer just filters what it is given.
(defn feedback--in-force? [s]
  (= (get s :status :accepted) :accepted))

;; ── 1. field scoping ─────────────────────────────────────────────
;; A signal is only about the (target, field) pair it names. A
;; correction with no field applies to the whole output; anything
;; outside that scope is a different target and stays separate.

(defn feedback--scope-key [s]
  (list (get s :target nil) (feedback--field s)))

(defn feedback--same-scope? [a b]
  (= (feedback--scope-key a) (feedback--scope-key b)))

;; ── 2. precedence ────────────────────────────────────────────────
;; Ranking within one scope: human > teacher > other. Strictly ordered,
;; so the view's winner is a function of the inputs, not of arrival
;; order.

(defn feedback--rank [s]
  (if (feedback--human? s) 3 (if (feedback--teacher? s) 2 1)))

(defn feedback--outranks? [a b]
  (> (feedback--rank a) (feedback--rank b)))

;; ── 3. conflicts ─────────────────────────────────────────────────
;; Disagreement inside the top rank is a conflict, not a winner. An
;; abstain is never a disagreement: "I cannot tell" is a valid
;; position that both a human and a teacher may hold.

(defn feedback--agrees? [a b]
  (or (= (get a :content nil) (get b :content nil))
      (and (get a :abstain false) (get b :abstain false))))

(defn feedback--group-disagrees? [heads]
  ;; true when some member disagrees with the first one. Abstain agrees
  ;; with abstain and is a real position, not a disagreement.
  (let* [tail (cdr heads)]
    (if (nil? tail)
      false
      (reduce (fn [found h]
                (if found
                  true
                  (not (feedback--agrees? (car heads) h))))
              false
              (if (nil? tail) '() tail)))))

(defn feedback--conflicts [signals]
  (let* [live (filter feedback--in-force? signals)
         ;; group by scope first, then order each group by rank. Sorting the
         ;; whole list before grouping lets a low-ranked signal become the
         ;; group head and hide a real conflict.
         grouped (reduce (fn [acc s]
                           (let [k (feedback--scope-key s)]
                             (put acc k (cons s (get acc k '())))))
                         {} live)]
    ;; A scope is conflicted when two in-force signals of the SAME top rank
    ;; disagree. Lower ranks never manufacture a conflict: a human answer
    ;; outranks a teacher label rather than fighting it.
    (filter (fn [entry]
              (let* [group (get entry 1)
                     top (feedback--rank (car group))
                     heads (filter (fn [s] (= (feedback--rank s) top)) group)]
                (feedback--group-disagrees? heads)))
            (seq-of grouped))))

;; ── 4. the view ──────────────────────────────────────────────────
;; A view maps each (target, field) to exactly one usable answer, or to
;; a conflict marker. Abstain flows through as a first-class value so a
;; downstream sample builder cannot mistake it for class 0.

(defn feedback--view [signals]
  (let* [live (filter feedback--in-force? signals)
         ranked (sort (fn [a b] (> (feedback--rank a) (feedback--rank b))) live)
         conflicted (feedback--conflicts signals)
         conflicted-keys (map (fn [entry] (get entry 0)) conflicted)
         ;; highest-ranked signal per scope, but only when nothing in
         ;; that scope is contested
         heads (reduce (fn [acc s]
                         (let [k (feedback--scope-key s)]
                           (if (get acc k nil)
                             acc
                             (put acc k s))))
                       {} ranked)
         resolved (reduce (fn [acc entry]
                            (let [k (get entry 0) s (get entry 1)]
                              (put acc k (if (feedback--present? conflicted-keys k)
                                           {:signal s :status :conflicted}
                                           {:signal s :status :resolved}))))
                          {} (seq-of heads))]
    resolved))

(defn feedback--present? [keys k]
  (reduce (fn [acc x] (if (= x k) true acc)) false keys))

(defn seq-of [m]
  ;; map → [k v] entries, the shape the view reducer works on
  (map (fn [k] (list k (get m k nil))) (keys m)))

;; ── 5. sample view ───────────────────────────────────────────────
;; What a training run is allowed to see: one answer per uncontested
;; scope, abstains kept as abstains. Conflicted scopes are absent —
;; not silently resolved, and not filled with a guess.

(defn feedback--samples [signals]
  (let* [view (feedback--view signals)
         entries (seq-of view)
         resolved (filter (fn [e] (= (get (get e 1) :status :resolved) :resolved)) entries)]
    (map (fn [e]
           (let* [entry (get e 1)
                  s (get entry :signal nil)]
             {:target (get s :target nil)
              :field (feedback--field s)
              :content (get s :content nil)
              :abstain (get s :abstain false)
              :source (get s :producer nil)}))
         resolved)))

;; ── 6. the frozen revision ───────────────────────────────────────
;; Membership is computed once and then only read. A later signal does
;; not mutate it; it produces the next revision.

(defn feedback--revision [signals policy-version revision-id split]
  (let* [samples (feedback--samples signals)]
    {:id revision-id
     :policy-version policy-version
     :split split
     :count (count samples)
     :abstains (count (filter (fn [s] (get s :abstain false)) samples))
     :signals (map (fn [e] (get (get (get (get e 1) :signal nil) nil) :id nil))
                   (filter (fn [e] (= (get (get e 1) :status :resolved) :resolved))
                           (seq-of (feedback--view signals))))
     :observations (map (fn [s] (get s :target nil)) samples)
     :members samples}))

;; Determinism contract: the same signal list always produces the same
;; revision, byte for byte — the frozen view is identified by its own
;; content, so a rebuilt view is recognisable as identical.
(defn feedback--revision-key [revision]
  (str (get revision :policy-version nil)
       "|" (get revision :split nil)
       "|" (get revision :count nil)
       "|" (get revision :abstains nil)
       "|" (str (get revision :signals nil))))

(println "zio.learn.feedback loaded (field-scoped precedence, conflict isolation, frozen views; pure policy, no host access)")
