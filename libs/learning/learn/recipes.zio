;; ── zio.learn.recipes — what may consume which signals, at what cost ──
;; A recipe is a declaration: the signal kinds it consumes, the parts of
;; the model it may train, its step budget and its initialization rule.
;; The loop checks a candidate against the recipe; the worker executes
;; what the recipe declares. Recipes are data, so a new method (W15's
;; distillation/preference/…) is a new value, not a new loop.

;; doc: (recipes--registry) — empty base registry; recipes--load-registry fills it.
(def recipes--registry {})

;; doc: (recipes--register registry recipe) — put recipe under its :id; re-registering
;; doc: an id replaces it.
(defn recipes--register [registry recipe]
  ;; recipes are versioned by id; re-registering an id replaces it
  (put registry (get recipe :id nil) recipe))

;; doc: (recipes--lookup registry id) — the recipe with that id, or nil.
(defn recipes--lookup [registry id]
  (get registry id nil))

;; The supervised hard-label recipe (W05): consumes teacher labels and
;; human corrections, trains every declared layer, fixed step budget,
;; deterministic seeded init.
;; doc: (recipes--supervised) — "supervised@1": consumes teacher labels + human
;; doc: corrections, trains all layers, CE loss, 512-step budget, seeded init.
(def recipes--supervised
  {:id "supervised@1"
   :consumes [:teacher-label :human-correction]
   :trainable :all            ; every declared layer may move
   :budget-steps 512
   :init :seeded              ; structural candidates start from the seed
   :loss "cross-entropy"})

;; doc: (recipes--check-signal recipe signal-kind) — true when the recipe consumes
;; doc: signal-kind; an unconsumed kind is refused, never silently ignored.
(defn recipes--check-signal [recipe signal-kind]
  ;; a recipe silently ignoring a signal kind would be an invisible
  ;; policy change; refusing is the honest behavior
  (let* [consumes (get recipe :consumes [])]
    (reduce (fn [found k] (if found true (= k signal-kind)))
            false consumes)))

;; doc: (recipes--budget-for recipe requested) — requested steps capped by the recipe's
;; doc: :budget-steps.
(defn recipes--budget-for [recipe requested]
  ;; a recipe caps what a candidate may spend, whatever it asks for
  (let* [cap (get recipe :budget-steps 0)]
    (if (> requested cap) cap requested)))

;; doc: (recipes--trainable? recipe layer-name) — true when the trainable policy is :all
;; doc: or lists layer-name.
(defn recipes--trainable? [recipe layer-name]
  (let* [policy (get recipe :trainable nil)]
    (or (= :all policy)
        (reduce (fn [found n] (if found true (= n layer-name)))
                false policy))))

;; ── W15: the extended recipe family ──────────────────────────────
;; Each of the five new methods is a *value* in the same registry, not a
;; new loop: the host dispatches on the recipe id and `apps/grove/workers/torch/recipes.py`
;; executes exactly what is declared here. The declarations exist to be
;; refused, so each one carries the contract field that makes it honest
;; — a distillation's teacher vocabulary, a policy's action set, a
;; demonstrator's legal actions — rather than a name and a hope.

;; doc: (recipes--vocab-matches? recipe teacher-vocab student-vocab) — true when the
;; doc: recipe declares no vocab, or both teacher and student vocab equal it exactly.
(defn recipes--vocab-matches? [recipe teacher-vocab student-vocab]
  ;; Soft distillation is only meaningful on ONE label space. A teacher
  ;; whose classes are not the student's classes must be refused, never
  ;; reshaped into the student's head: reshaping would invent a
  ;; distribution over classes the teacher never expressed.
  (let* [want (get recipe :teacher-vocab nil)]
    (or (nil? want)
        (and (= (list teacher-vocab) (list want))
             (= (list student-vocab) (list want))))))

;; doc: (recipes--teacher-vocab-declared? recipe) — true when the recipe declares
;; doc: :teacher-vocab.
(defn recipes--teacher-vocab-declared? [recipe]
  (not (nil? (get recipe :teacher-vocab nil))))

;; doc: (recipes--legal-action? recipe action) — true when action is inside the
;; doc: declared :legal-actions; anything else is masked out of the loss.
(defn recipes--legal-action? [recipe action]
  ;; Demonstration cloning is supervised on demonstrator actions inside a
  ;; DECLARED action space. An action outside it is masked out of the
  ;; loss, not trained: the model is not asked to imitate behaviour the
  ;; contract says is not available to it.
  (reduce (fn [found a] (if found true (= a action)))
          false (get recipe :legal-actions [])))

;; doc: (recipes--preference-usable? recipe preferred unpreferred) — true when neither
;; doc: side of the pair abstains (abstention is a position, not a negative).
(defn recipes--preference-usable? [recipe preferred unpreferred]
  ;; An abstention is not a loss. "I cannot tell" is a position, not a
  ;; negative, so a pair that contains one is excluded from the objective
  ;; and counted — never trained as a rejected alternative.
  (and (not (get preferred :abstain false))
       (not (get unpreferred :abstain false))))

;; doc: (recipes--action-set-declared? recipe) — true when the recipe declares a
;; doc: non-empty :actions set; policies without one are refused.
(defn recipes--action-set-declared? [recipe]
  ;; A policy recipe without an explicit action set has no termination or
  ;; reward contract to hold the policy to, so it is refused rather than
  ;; read as "any action".
  (let* [actions (get recipe :actions nil)]
    (and (not (nil? actions)) (> (count actions) 0))))

;; doc: (recipes--delayed-binds-trajectory? recipe result) — true when the delayed
;; doc: result names a non-empty :trajectory-id; otherwise refused at submission.
(defn recipes--delayed-binds-trajectory? [recipe result]
  ;; A delayed outcome must name the trajectory it belongs to. An
  ;; unattributable result cannot be attributed later either, so it is
  ;; refused at submission instead of being silently assigned.
  (let* [traj (get result :trajectory-id nil)]
    (and (not (nil? traj)) (not (= traj "")))))

;; ── the registry ────────────────────────────────────────────────
;; `recipes--registry` collects the declarations the driver dispatches
;; on. Re-registering an id replaces it, so a version bump is data.

;; doc: (recipes--soft-distill) — "soft-distill@1": KL at temperature 2.0 on the
;; doc: teacher's softmax; teacher vocab declared, must equal the student's.
(def recipes--soft-distill
  {:id "soft-distill@1"
   :consumes [:teacher-label]
   :trainable :all
   :budget-steps 512
   :init :seeded
   :loss "kl-divergence"
   :temperature 2.0
   ;; the contract field: a soft target is only usable on the student's
   ;; own label space, so the vocabulary is declared, not inferred
   :teacher-vocab ["clear" "fault"]})

;; doc: (recipes--hard-distill) — "hard-distill@1": cross-entropy on the teacher's
;; doc: argmax labels; all layers trainable, 512-step budget.
(def recipes--hard-distill
  {:id "hard-distill@1"
   :consumes [:teacher-label]
   :trainable :all
   :budget-steps 512
   :init :seeded
   :loss "cross-entropy"})

;; doc: (recipes--preference) — "preference@1": pairwise logistic loss; abstaining pairs
;; doc: are excluded from the objective, never trained as negatives.
(def recipes--preference
  {:id "preference@1"
   :consumes [:human-preference]
   :trainable :all
   :budget-steps 512
   :init :seeded
   :loss "pairwise-logistic"
   ;; abstain is a valid position on either side; a pair holding one is
   ;; excluded from the objective, never trained as a negative
   :abstain-is-loss false})

;; doc: (recipes--demonstration) — "demonstration@1": masked cross-entropy over the
;; doc: declared :legal-actions; actions outside the set are masked, not trained.
(def recipes--demonstration
  {:id "demonstration@1"
   :consumes [:demonstration]
   :trainable :all
   :budget-steps 512
   :init :seeded
   :loss "masked-cross-entropy"
   ;; the contract field: supervised on demonstrator actions restricted to
   ;; a declared legal action space. A demonstration that names anything
   ;; outside this set is masked out of the loss, not trained.
   :legal-actions ["clear" "fault"]})

;; doc: (recipes--self-supervised) — "self-supervised@1": masked reconstruction;
;; doc: :task-gate is required — reconstruction never substitutes for task acceptance.
(def recipes--self-supervised
  {:id "self-supervised@1"
   :consumes [:demonstration]
   :trainable :all
   :budget-steps 512
   :init :seeded
   :loss "masked-reconstruction"
   ;; self-supervision may improve the representation but NEVER substitutes
   ;; for task acceptance: :task-gate is the task's own evaluation, and a
   ;; run that cannot pass it does not become a candidate however well it
   ;; reconstructs.
   :task-gate "holdout-accuracy>=0.90"})

;; doc: (recipes--environment-feedback) — "environment-feedback@1": REINFORCE on delayed
;; doc: returns; every result must bind to a named trajectory.
(def recipes--environment-feedback
  {:id "environment-feedback@1"
   :consumes [:environment-result]
   :trainable :all
   :budget-steps 512
   :init :seeded
   :loss "trajectory-return"
   ;; a delayed outcome names the trajectory it settles; one that cannot
   ;; is refused at submission
   :binds :trajectory
   :delay-allowed true})

;; doc: (recipes--policy-gradient) — "policy-gradient@1": REINFORCE with baseline on a
;; doc: restricted lineworld; explicit action set, reward and termination contract.
(def recipes--policy-gradient
  {:id "policy-gradient@1"
   :consumes [:environment-result]
   :trainable :all
   :budget-steps 512
   :init :seeded
   :loss "reinforce"
   ;; The contract is the point, not the coverage: an explicit action set,
   ;; a reward, and a termination rule. This is a RESTRICTED discrete
   ;; policy over a declared environment, not a claim about arbitrary RL.
   ;;
   ;; The action set below is exactly the environment the executor
   ;; implements (a line of cells; left / right / stay). Action 2 is
   ;; "stay": it is legal and deliberately useless, so a policy that
   ;; learns nothing still has somewhere to put its indecision.
   :actions ["left" "right" "stay"]
   :reward "step-cost-and-goal-bonus"
   :termination "reach-goal-or-max-steps"})

;; doc: (recipes--all) — vector of every recipe declaration the driver dispatches on.
(def recipes--all
  [recipes--supervised
   recipes--hard-distill
   recipes--soft-distill
   recipes--preference
   recipes--demonstration
   recipes--self-supervised
   recipes--environment-feedback
   recipes--policy-gradient])

;; doc: (recipes--load-registry) — registry map of all recipes in recipes--all, keyed
;; doc: by id.
(defn recipes--load-registry []
  (let [reg recipes--registry]
    (reduce (fn [acc r] (recipes--register acc r)) reg recipes--all)))

