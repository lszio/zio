;; ── zio.agent — the agent's own decision logic, in Zio ─────────────
;;
;; This module used to be a data model whose `step` echoed canned text:
;; the shape of an agent, with none of the behaviour. It is now the
;; part that decides — route, validate, revise, stop — and the two
;; things it cannot do itself are host bindings:
;;
;;   (harness-complete task feedback) -> a reply map with "source"
;;   (harness-execute-zio source)     -> an outcome map with "status"
;;
;; The split is the point. This file decides *when* to ask the model
;; and *what* to do with the answer; the host decides what a model
;; call costs, what a program is allowed to reach, and how long it may
;; run. A program cannot grant itself more turns than the grant allows
;; — the host counts them, so a loop here that asks for ten thousand
;; turns gets the number the grant gave it.
;;

;; A reply with no source is not a program. Treating it as one would
;; hand the host an empty string and report whatever the sandbox said
;; about it, which reads like a result about the model's code when the
;; model never wrote any.
;;
;; Both host bindings return keyword-keyed maps — that is the Zio map
;; convention, and reading them with string keys returns the default
;; every time, which is how a failed turn ends up looking like it
;; carried no error at all.
(defn source-of [reply]
  (let* [source (get reply :source "")]
    (if (= source "")
      nil
      source)))

;; The feedback the next turn sees. The error is carried whole, not
;; summarized: a revision that is shown a paraphrase of why it failed
;; is a revision guessing.
(defn feedback-of [outcome]
  {:status (get outcome :status "failed")
   :error (get outcome :error "no error detail was reported")
   :turns (get outcome :turns 0)})

;; Run the agent loop.
;;
;; `max-turns` is the ceiling the host passed in from the grant, not a
;; number this function decided: the call count is also metered there,
;; so a program that ignored this argument would still be stopped.
(defn agent-run [task max-turns]
  (loop [turn 0 feedback nil]
    (if (>= turn max-turns)
      {:status "exhausted"
       :turns turn
       :last feedback}
      (let* [reply (harness-complete task feedback)
             source (source-of reply)
             outcome (if (nil? source)
                       {:status "failed"
                        :error "the model returned no source to execute"}
                       (harness-execute-zio source))]
        (if (= (get outcome :status "failed") "completed")
          {:status "candidate"
           :turns (+ turn 1)
           :execution outcome}
          (recur (+ turn 1) (feedback-of outcome)))))))

