;; ── Zio Core Standard Library ──────────────────────────────────
;; Auto-loaded at startup. Defines fundamental combinators,
;; sequence operations, and type utilities.
;;
;; NOTE: loaded via CLI bootstrap, not via require.
;; All code here must work with builtins only (no require).

;; ── Basic Combinators ─────────────────────────────────────────

(defn identity [x] x)
(defn constantly [x] (fn [_] x))

(defn inc [x] (+ x 1))
(defn dec [x] (- x 1))

;; ── Data Structures ───────────────────────────────────────────

(defmacro defstruct [name fields]
  ;; Accept [x y] or (x y); convert to list for uniform processing
  (let* [flds (if (vector? fields) (apply list fields) fields)
        build-result
        (fn [fld-list]
          (loop [r fld-list m {}]
            (if (nil? r)
              m
              (recur (cdr r)
                (put m (keyword (car r)) (car r))))))
        defn-form (list 'defn name (apply vector flds) (build-result flds))
        accessor-forms
        (map (fn [field]
          (let [acc-name (symbol (str name "-" field))]
            (list 'defn acc-name (vector 'obj)
              (list 'get 'obj (keyword field)))))
          flds)]
    ;; (cons 'do (cons defn-form accessor-forms)) → (do defn-form acc1 acc2 ...)
    (cons 'do (cons defn-form accessor-forms))))

;; ── Logical ──────────────────────────────────────────────────

(defn not [x] (if x false true))

(defn and [& args]
  (if (= (count args) 0)
    true
    (if (first args)
      (if (= (count args) 1)
        (first args)
        (apply and (rest args)))
      false)))

(defn or [& args]
  (if (= (count args) 0)
    nil
    (if (first args)
      (first args)
      (apply or (rest args)))))

;; ── Sequence ─────────────────────────────────────────────────

(defn first [coll]
  (if (list? coll) (car coll) (get coll 0)))

(defn second [coll]
  (first (rest coll)))

(defn rest [coll]
  (if (list? coll) (cdr coll) (get coll 1)))

(defn last [coll]
  (if (nil? (cdr coll))
    (car coll)
    (last (cdr coll))))

(defn nth [coll n]
  (if (nil? coll)
    nil
    (if (= n 0) (first coll) (nth (rest coll) (dec n)))))

;; ── Higher-order ─────────────────────────────────────────────

(defn partial [f & args]
  (fn [& more-args]
    (apply f (apply list (apply list args more-args)))))

;; ── Predicate ────────────────────────────────────────────────

(defn zero? [x] (= x 0))
(defn pos? [x] (< 0 x))
(defn neg? [x] (< x 0))
(defn even? [x] (= (mod x 2) 0))
(defn odd? [x] (not (even? x)))

(defn empty? [coll]
  (or (nil? coll)
      (and (vector? coll) (= (count coll) 0))))

(defn some? [x] (not (nil? x)))

;; ── Sequence Operations ──────────────────────────────────────

;; (take n coll) → first n elements as a list
(defn take [n coll]
  (if (or (nil? coll) (= n 0))
    nil
    (cons (first coll) (take (dec n) (rest coll)))))

;; (drop n coll) → coll without first n elements
(defn drop [n coll]
  (if (or (nil? coll) (= n 0))
    coll
    (drop (dec n) (rest coll))))

;; (into to from) → add elements of from to to, converting type if needed
(defn into [to from]
  (if (nil? from)
    to
    (if (list? to)
      ;; For lists, prepend in reverse then reverse at end
      (let [result (into to (rest from))]
        (if (nil? result)
          (list (first from))
          (cons (first from) result)))
      ;; For vectors, apply vector after converting both to lists
      (apply vector (apply list to (apply list from))))))


;; ── Module export marker ─────────────────────────────────────
;; All defs above are implicitly exported.
