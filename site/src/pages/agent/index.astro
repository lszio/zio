---
import Base from '../../layouts/Base.astro';
import { scenarios } from '../../data/agent';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cards = [
  { key: 'toolAgent', n: '①', title: 'Tool-Calling 路由模拟', desc: '本地关键词规则选择 weather / calc 预置结果；这是语言组合演示，不是真实 LLM 或完整 Agent harness。' },
  { key: 'cspAgents', n: '②', title: 'CSP 消息队列模拟', desc: 'Planner / Executor 顺序投递消息，协调者汇聚收件箱；当前 Channel 为同步队列演示，不代表并发 Agent 调度。' },
  { key: 'llmPipeline', n: '③', title: 'LLM 结构化输出模拟', desc: '预置补全数据 → 槽位提取 → json-stringify 序列化；不调用模型，也不证明模型输出通过安全校验。' },
];
---
<Base title="Agent / LLM 模拟实验 — Zio 通用 Lisp" description="真实 Zio WASM 求值的本地规则与 Q-learning 模拟；不是 Grove 产品、真实 LLM harness 或训练服务。">
  <section class="hero">
    <div class="container">
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        General-Purpose Core • Agent-Ready • Real WASM Evaluation
      </div>
      <h1>通用语言，本地 Agent 模拟。</h1>
      <p class="hero-lead">
        Zio 的核心定位是一门<b>通用编程语言</b>——Agent 编排不是它的存在理由，而是它擅长的工作负载之一。
        CSP、ZOS 和 JSON 提供语言组合原语，ZOS 与编译器工具链仍属语言；不是已完成的模型／工具／会话／预算／取消 harness。
        本页真实执行 Zio WASM，LLM 响应与学习环境是本地模拟，无服务器或模型调用。
        同像性支持表示和编辑代码，不提供神经模型透明性或正确性证明；WASM 不替代能力检查与宿主隔离。
        Planned：Grove 按需消费官方独立库 Numa（连续数组、矩阵、向量与数值后端）、Rill（参数、子命令、帮助、命令组合、终端 IO、退出状态）、Loom（模型、工具、会话、预算、取消、provider、ACP）。
        三库独立版本，不是语言内建层；core 无反向依赖。Grove 负责业务实验、反馈、检查点、逻辑演化、评估、人工批准与产品 Web；当前 zio-ai 未改名，zio-cli 二进制不是 Rill 库。
      </p>
      <div class="hero-cta">
        <a href="#training" class="btn btn-primary">观看训练过程</a>
        <a href="#playground" class="btn btn-secondary">试用 Agent 编排</a>
        <a href={`${base}/grove/`} class="btn btn-secondary">grove 自学习产品 →</a>
      </div>
    </div>
  </section>

  <section class="section section-tight" style="background: rgba(0,0,0,0.2);">
    <div class="container">
      <div class="section-header">
        <h2>通用语言的 Agent 组合原语</h2>
        <p>语言原语是基础；Planned：Loom 提供模型、工具、会话、预算、取消与 ACP harness，Grove 负责学习、评估与批准</p>
      </div>
      <div class="grid-2x2">
        <div class="card">
          <div class="card-icon">📡</div>
          <h3>CSP 通道 = Agent 消息总线</h3>
          <p><code>chan / send! / recv!</code> 展示消息传递；完整任务调度、取消和跨进程隔离不是通道本身提供的保证。</p>
        </div>
        <div class="card">
          <div class="card-icon">🧱</div>
          <h3>ZOS 对象系统 = Agent 建模</h3>
          <p>ZOS 的 Class／Generic Function／Method 子集可表达对象与能力分派；完整 MOP 为 Planned，不意味着 Agent harness 已实现。</p>
        </div>
        <div class="card">
          <div class="card-icon">🔀</div>
          <h3>JSON 原语 = LLM 结构化接口</h3>
          <p><code>json-parse / json-stringify</code> 提供结构化数据读写；真实模型接入、响应验证与能力检查仍由 harness 承担。同像性允许表示和编辑代码，不证明生成代码正确。</p>
        </div>
        <div class="card">
          <div class="card-icon">📦</div>
          <h3>WASM = 宿主执行边界</h3>
          <p>显式 EvalContext 支持状态隔离；JS FFI、权限、资源预算与非确定性输入仍需宿主约束，不承诺跨环境逐位一致。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="training">
    <div class="container">
      <div class="section-header">
        <h2>本地 Q-learning 模拟：真实 Zio 求值</h2>
        <p>策略与 Q 值更新由 Zio WASM 实时计算；这不是 Grove 训练服务或真实 LLM 学习闭环</p>
      </div>

      <div class="agent-controls" style="margin-bottom: 16px;">
        <button id="train-toggle" class="btn btn-primary">▶ 开始训练</button>
        <button id="train-reset" class="btn btn-secondary">重置</button>
        <label>探索率 ε <input id="eps-slider" type="range" min="50" max="500" step="10" value="200"> <span id="eps-val">0.20</span></label>
        <label>速度 <input id="speed-slider" type="range" min="1" max="10" value="4"> <span id="speed-val">4</span></label>
      </div>

      <div class="agent-grid">
        <div class="code-panel">
          <div class="code-panel-header">
            <span>training.zio — 每批回合由 WASM 求值一次（实时更新）</span>
            <span id="engine-badge" class="logo-tag">⚡ WASM Loading...</span>
          </div>
          <pre id="train-source">;; 等待引擎初始化...</pre>
        </div>
        <div class="chart-panel">
          <canvas id="reward-chart"></canvas>
          <div class="q-bars" id="q-bars"></div>
          <div class="stat-chips" id="train-stats"></div>
          <div class="sim-note">环境说明：4 臂老虎机（真实回报率 0.70 / 0.50 / 0.30 / 0.10，浏览器内模拟，无网络请求）。
          奖励采样由环境给出；<b>臂选择、ε-greedy 探索、Q 值增量更新全部由 Zio 代码计算</b>。Q 状态跨批次持久（经宿主回注）。</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="playground" style="background: rgba(0,0,0,0.2);">
    <div class="container">
      <div class="section-header">
        <h2>试用效果：三个 Agent / LLM 编排场景</h2>
        <p>点击运行，即刻在浏览器中求值真实 Zio 程序（LLM 响应为本地规则模拟，页面无 API Key、无网络调用）</p>
      </div>
      <div class="scenario-grid">
        {cards.map((c) => (
          <div class="scenario-card">
            <h3>{c.n} {c.title}</h3>
            <p>{c.desc}</p>
            <pre class="src" id={`src-${c.key}`}></pre>
            <button class="btn btn-primary run-scenario" data-scenario={c.key}>▶ 运行</button>
            <div class="scenario-output" id={`out-${c.key}`}>待运行…</div>
          </div>
        ))}
      </div>
    </div>
    <div class="container">
      <p class="sim-note">Planned：Grove 独立 APP 将执行 Zio Agent 逻辑，经真实 LLM 生成代码、解析、能力检查与隔离执行，以错误和证据修订；Web 展示源码、实际路径与 diff。反馈产生逻辑候选，独立评估后由人批准正式版本。自动实验只限批准预算和编辑范围；可信基线、鉴权、评估与发布守卫不可自改。ACP（Agent Client Protocol）先 client／teacher adapter、后 server，当前尚未实现。</p>
    </div>
  </section>

  <script>
    import { initAgentPage } from '../../scripts-agent.js';
    initAgentPage();
  </script>
</Base>
