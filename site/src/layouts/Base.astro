---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// `base: '/site'` in astro.config.mjs — Astro.base is the single source of
// truth for the prefix. The old hand-written HTML hardcoded `.wasm/...`
// relative paths, which break the moment a page is not served from the
// directory those paths were written against.
const base = import.meta.env.BASE_URL;
const links = [
  { href: `${base}/#philosophy`, label: '设计哲学' },
  { href: `${base}/#architecture`, label: '分层架构' },
  { href: `${base}/#features`, label: '核心特性' },
  { href: `${base}/agent/`, label: 'Agent & LLM' },
  { href: `${base}/grove/`, label: 'grove 自学习' },
];
const docs = [
  { href: `${base}/../docs/status.md`, label: 'Status' },
  { href: `${base}/../docs/feature-matrix.md`, label: 'Feature Matrix' },
  { href: `${base}/../docs/zos-spec.md`, label: 'ZOS Spec' },
  { href: `${base}/../docs/zio-architecture.md`, label: 'Architecture' },
  { href: `${base}/../docs/adrs.md`, label: 'ADRs' },
];
const current = Astro.url.pathname;
// Hash links stay on the landing page; only the real subpages get aria-current.
const isActive = (href: string) => !href.includes('#') && current.startsWith(href.replace(/\/$/, ''));
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="bg-glow"></div>

  <header>
    <div class="container nav-bar">
      <a href={`${base}/`} class="logo">
        <span class="logo-brackets">&lt;(</span>ZIO<span class="logo-brackets">)&gt;</span>
        <span class="logo-tag">v0.2.0</span>
      </a>
      <ul class="nav-links">
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <div class="nav-actions">
        <slot name="actions">
          <a href={`${base}/#terminal`} class="btn btn-primary">WASM REPL</a>
          <a href="https://github.com/lszio/zio" target="_blank" rel="noopener" class="btn btn-secondary">GitHub</a>
        </slot>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <div class="container footer-grid">
      <div>
        <div class="logo" style="margin-bottom: 8px;">
          <span class="logo-brackets">&lt;(</span>ZIO<span class="logo-brackets">)&gt;</span>
        </div>
        <p>A Modern General-Purpose Lisp. Built with Rust, WASM &amp; Lisp — 从脚本到 Agent，一门语言。</p>
      </div>
      <div class="footer-links">
        {docs.map((d) => <a href={d.href}>{d.label}</a>)}
      </div>
    </div>
  </footer>
</body>
</html>
