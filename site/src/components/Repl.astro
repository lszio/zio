---
const presets = [
  { key: 'jseval', label: 'JS 互操作 (eval & DOM)' },
  { key: 'syntax', label: 'syntax-rules 卫生宏' },
  { key: 'zos', label: 'ZOS 类与多分派' },
  { key: 'csp', label: 'CSP Channel 与并发' },
  { key: 'json', label: 'JSON 序列化' },
];
---
<div class="terminal-card" id="terminal">
  <div class="terminal-header">
    <div class="terminal-dots">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
    </div>
    <span class="terminal-title">Zio WASM Live Terminal</span>
    <span id="wasm-status-badge" class="logo-tag">⚡ WASM Loading...</span>
  </div>
  <div class="terminal-presets">
    {presets.map((p, i) => (
      <button class:list={['preset-btn', { active: i === 0 }]} data-preset={p.key}>{p.label}</button>
    ))}
  </div>
  <div class="terminal-body" id="repl-output"></div>
  <div class="repl-input-row">
    <span class="repl-prompt">zio&gt;</span>
    <input id="repl-input" type="text" placeholder="输入 (js/eval ...), (defclass ...), 或 (+ 1 2)... 按 Enter 执行" />
  </div>
</div>
