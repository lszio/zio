---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

// Subpages are external .mdx files under apps/site/content/ — a new page is a new
// file, no component work. The landing page is index.astro and is not part
// of this collection.
export async function getStaticPaths() {
  const entries = await getCollection('pages', (e) => e.id !== 'index');
  return entries
    .sort((a, b) => a.data.order - b.data.order)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${entry.data.title} — Zio`} description={entry.data.description}>
  <section class="hero hero-page-head">
    <div class="container">
      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        {entry.id === 'contribute' ? '贡献与开发' : 'Zio 语言'}
      </div>
      <h1>{entry.data.title}</h1>
      <p class="hero-lead">{entry.data.description}</p>
      <div class="hero-cta">
        <a href={`${base}/docs/`} class="btn btn-secondary">学习路线</a>
        <a href={`${base}/playground/`} class="btn btn-secondary">打开 Playground</a>
        <a href={`${base}/${entry.id === 'contribute' ? 'book' : 'contribute'}/`} class="btn btn-secondary">{entry.id === 'contribute' ? '实现手册' : '参与开发'}</a>
      </div>
    </div>
  </section>

  <article class="section prose container">
    <Content />
  </article>
</Base>
