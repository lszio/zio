---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
const buildInfo = import.meta.env.ZIO_BUILD_INFO;

export async function getStaticPaths() {
  const sections = ['docs', 'book', 'blog'] as const;
  const groups = await Promise.all(sections.map(async (section) => {
    const entries = await getCollection(section);
    return entries.map((entry) => ({
      params: { section, slug: entry.id },
      props: { entry, section },
    }));
  }));
  return groups.flat();
}

const { entry, section } = Astro.props;
const { Content } = await render(entry);
const title = entry.body?.match(/^#\s+(.+)$/m)?.[1] ?? entry.id;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${title} — Zio`} description={`Zio ${section} · ${title}`}>
  <section class="hero hero-page-head">
    <div class="container">
      <h1>{title}</h1>
      <div class="hero-cta">
        <a href={`${base}/${section}/`} class="btn btn-secondary">← 返回目录</a>
        <a href={`${base}/playground/`} class="btn btn-primary">在 Playground 运行 Zio</a>
        <a href={`https://github.com/lszio/zio/blob/${buildInfo.commit ?? 'main'}/${section}/${entry.id}.md`} class="btn btn-secondary">源文档{buildInfo.commit ? '（对应提交）' : ''}</a>
      </div>
    </div>
  </section>
  <article class="section prose container"><Content /></article>
</Base>
