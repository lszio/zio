---
const tabs = [
  { key: 'jsinterop', label: 'JS/Web 互操作 (WASM)' },
  { key: 'syntax', label: '卫生宏 syntax-rules' },
  { key: 'zos', label: 'ZOS 类与通用函数' },
  { key: 'csp', label: '同步 Channel 与 Future 占位能力' },
];
---
<div class="code-tab-wrapper">
  <div class="code-tabs">
    {tabs.map((t, i) => (
      <button class:list={['code-tab-btn', { active: i === 0 }]} data-snippet={t.key}>{t.label}</button>
    ))}
  </div>
  <div class="code-view">
    <pre id="code-display"></pre>
  </div>
</div>
