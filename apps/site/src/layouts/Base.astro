---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// The site is served from the domain root, but Astro.base stays the single
// source of truth for the prefix so the same build works behind a subpath.
// Normalised once: BASE_URL is '/' at the root and a bare '/site' on a
// subpath, so every join below writes `${base}/…` explicitly rather than
// relying on which shape it got.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/intro/`, label: '语言介绍' },
  { href: `${base}/docs/`, label: '文档' },
  { href: `${base}/syntax/`, label: '语法' },
  { href: `${base}/reference/`, label: 'API 参考' },
  { href: `${base}/playground/`, label: 'Playground' },
  { href: `${base}/agent/`, label: 'Agent 模拟' },
  { href: `${base}/grove/`, label: 'Grove APP 方向' },
];
const docs = [
  { href: `${base}/docs/status/`, label: 'Status' },
  { href: `${base}/docs/feature-matrix/`, label: 'Feature Matrix' },
  { href: `${base}/docs/zos-spec/`, label: 'ZOS Spec' },
  { href: `${base}/docs/zio-architecture/`, label: 'Architecture' },
  { href: `${base}/docs/superpowers/plans/2026-10-07-language-first-layout/`, label: 'Implementation Plan' },
  { href: `${base}/docs/adrs/`, label: 'ADRs' },
];
const current = Astro.url.pathname;
// Hash links stay on the landing page; only the real subpages get aria-current.
const isActive = (href: string) => !href.includes('#') && current.startsWith(href.replace(/\/$/, ''));
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="bg-glow"></div>

  <header>
    <div class="container nav-bar">
      <a href={`${base}/`} class="logo">
        <span class="logo-brackets">&lt;(</span>ZIO<span class="logo-brackets">)&gt;</span>
        <span class="logo-tag">v0.2.0</span>
      </a>
      <ul class="nav-links">
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <div class="nav-actions">
        <slot name="actions">
          <a href={`${base}/playground/`} class="btn btn-primary">运行 Zio</a>
          <a href="https://github.com/lszio/zio" target="_blank" rel="noopener" class="btn btn-secondary">GitHub</a>
        </slot>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Sitewide doc enhancement: rainbow-paren lisp highlighting, paren-pair
       click/jump, mermaid fences, table scroll wrappers (scripts/doc-rich.js). -->
  <script>
    import '../scripts/doc-rich.js';
  </script>

  <footer>
    <div class="container footer-grid">
      <div>
        <div class="logo" style="margin-bottom: 8px;">
          <span class="logo-brackets">&lt;(</span>ZIO<span class="logo-brackets">)&gt;</span>
        </div>
        <p>A Modern General-Purpose Lisp. Built with Rust, WASM &amp; Lisp — 从脚本到 Agent，一门语言。</p>
      </div>
      <div class="footer-links">
        {docs.map((d) => <a href={d.href}>{d.label}</a>)}
      </div>
    </div>
  </footer>
</body>
</html>
