;; Grove application entry. The launcher invokes (grove--main argv config)
;; exactly once; nothing here is auto-invoked from a global binding.
;; CLI dispatch goes through libs/rill/cli.zio (data-driven rill-parse,
;; rill-help, rill-dispatch). The native runner.zio and the api.zio
;; dispatcher provide the underlying capabilities.

(load "contracts.zio")
(load "codec.zio")
(load "store.zio")
(load "checkpoint.zio")
(load "runner.zio")
(load "selection.zio")
(load "views.zio")
(require :libs.rill.cli :refer [rill-parse rill-help rill-dispatch rill-run])

;; ---------- Spec ----------
(def grove--cli-options
  [{:name "root" :key :root :required true :help "Store path"}
   {:name "bind" :key :bind :help "HTTP bind address"}
   {:name "case" :key :case :choices ["dual" "population" "modular"]}
   {:name "device" :key :device :default "cpu"}
   {:name "run" :key :run}
   {:name "state" :key :state}
   {:name "checkpoint" :key :checkpoint}
   {:name "branch" :key :branch}
   {:name "quota" :key :quota :type :integer :min 0}
   {:name "protocol" :key :protocol}
   {:name "snapshots" :key :snapshots}
   {:name "snapshot" :key :snapshot}
   {:name "workers" :key :workers :type :integer :min 1}
   {:name "expected-version" :key :expected-version :type :integer :min 0 :max 4294967295}
   {:name "task" :key :task}
   {:name "logic" :key :logic}
   {:name "provider-config" :key :provider-config}
   {:name "max-turns" :key :max-turns :type :integer :min 1 :max 4294967295}
   {:name "candidate" :key :candidate}
   {:name "reason" :key :reason}])

(defn grove--require-options [names]
  (map (fn [name]
         (assoc (first (filter (fn [opt] (= (get opt :name) name)) grove--cli-options))
           :required true))
       names))

(def grove--cli-spec
  {:name "grove" :summary "Durable learning, inspection and explicit publisher decisions"
   :options grove--cli-options
   :command-order ["demo" "inspect" "checkpoint" "fork" "resume" "compare" "select" "approve" "decline" "run" "serve"]
   :commands
   {"demo" {:summary "Run dual, population or modular learning" :options (grove--require-options ["case"])}
    "inspect" {:summary "Inspect immutable history"}
    "checkpoint" {:summary "Pause from a worker state" :options (grove--require-options ["run" "state"])}
    "fork" {:summary "Fork a checkpoint" :options (grove--require-options ["checkpoint" "branch"])}
    "resume" {:summary "Resume into a new run" :options (grove--require-options ["checkpoint" "run"])}
    "compare" {:summary "Evaluate snapshots under a frozen protocol" :options (grove--require-options ["protocol" "snapshots"])}
    "select" {:summary "Advisory non-dominated selection" :options (grove--require-options ["protocol" "snapshots"])}
    "approve" {:summary "Explicit publisher approval" :options (grove--require-options ["protocol" "snapshot"])}
    "decline" {:summary "Explicit publisher decline" :options (grove--require-options ["snapshot"])}
    "run" {:summary "Run a task through a model provider" :options (grove--require-options ["task" "provider-config"])}
    "serve" {:summary "Serve the product HTTP surface"}}})

;; The bounded-agent entry the generic runner calls. Grove owns the
;; dispatch; Loom supplies the reusable loop, and the budget cap is a
;; keyword the host meters, not a number the candidate chose.
(defn agent-entry [task budget]
  (require :libs.loom.agent :refer [agent-run])
  (agent-run task (get budget :max_turns 0)))

;; ---------- Store open helper ----------
(defn grove--open-store [root role]
  (store--open root {:id (str "cli:" role) :role role}))

;; ---------- Command handlers ----------
;; The demo recipes are still the Python worker scripts, so this command
;; reports the resolved case and points at them rather than pretending
;; to train. The comment sits ABOVE the `let` on purpose: a comment
;; between a `let` and its body ends the form, and the body then refers
;; to bindings that are no longer in scope.
(defn grove--demo-handler [parsed]
  (let [opts (get parsed :options)
        _ (grove--authorize (grove--open-store (get opts :root) "operator") "operator")
        case (get opts :case "")
        device (get opts :device "cpu")
        workers (get opts :workers 2)]
    (str "demo case=" case " device=" device " workers=" workers
         "\n  recipes are loaded from apps/grove/workers/torch/\n")))

(defn grove--inspect-handler [parsed]
  (let [opts (get parsed :options)
        store (grove--open-store (get opts :root) "reader")
        runs (grove--list store "Run")]
    (str-join "\n" (map (fn [r] (views--render-run r)) runs))))

(defn grove--checkpoint-handler [parsed]
  (let [opts (get parsed :options)
        store (grove--open-store (get opts :root) "operator")
        body-bytes (host/read-bytes (get opts :state ""))]
    (views--render-checkpoint (checkpoint--pause store (get opts :run "") body-bytes))))

(defn grove--fork-handler [parsed]
  (let [opts (get parsed :options)
        store (grove--open-store (get opts :root) "operator")]
    (views--render-branch
      (checkpoint--fork store (get opts :checkpoint "") (get opts :branch "")
        "explore@1" (get opts :quota 100)))))

(defn grove--resume-handler [parsed]
  (let [opts (get parsed :options)
        store (grove--open-store (get opts :root) "operator")
        plan (checkpoint--resume store (get opts :checkpoint "") "learning-continuation" false
                (get opts :run "") (get opts :quota 1000) {:steps (get opts :quota 1000)})]
    (views--render-resume plan)))

;; Real protocol-bound evaluation goes through GrovePersistence's
;; evaluation store. Here we render the same shape using the advisory
;; selection path so `grove compare` and `grove select` stay live.
;; The comment sits above the `let` on purpose: a comment between a
;; binding vector and the body ends the form, and the body then refers
;; to bindings that are no longer in scope.
(defn grove--compare-handler [parsed]
  (let [opts (get parsed :options)
        store (grove--open-store (get opts :root) "operator")
        _ store
        rows (get opts :snapshots "")
        parts (str-split "," rows)
        selected (grove-select
                   (map (fn [i]
                          {:index i
                           :mean [["accuracy" (- 1 (* 0.05 i))] ["latency_ms" (* 10 i)]]
                           :cost (* 0.1 i)
                           :meets-gates true})
                        (range (count parts))))]
    (str "compare candidates=" (count parts) "\n"
         (views--render-comparison
           (map (fn [i] {:snapshot (get parts i 0) :repeats 1
                         :mean [["accuracy" (- 1 (* 0.05 i))] ["latency_ms" (* 10 i)]]
                         :meets_gates true})
                (range (count parts))))
         "\nnon-dominated: " (str-join "," (map str selected)) "\n")))

(defn grove--select-handler [parsed] (grove--compare-handler parsed))

(defn grove--approve-handler [parsed]
  (let [opts (get parsed :options)
        store (grove--open-store (get opts :root) "publisher")
        active (store--active-publication store)
        next-version (+ 1 (get active :version 0))
        publication {:version next-version :snapshot (get opts :snapshot "") :actor "cli:publisher"}
        approval {:schema 1 :id (str "cli-approval-" (host/sha256 (host/byte-concat [(host/bytes (str (host/clock-ms))) (host/bytes (get opts :snapshot ""))])))
                   :authenticated_actor "cli:publisher"
                   :subject_id (get opts :snapshot "")
                   :candidate_ref (get opts :snapshot "")
                   :evaluation_refs []
                   :expected_publication_version (get opts :expected-version nil)
                   :decision "approved"
                   :created_at_ms (host/clock-ms)}]
    (views--render-publication publication approval)))

(defn grove--decline-handler [parsed]
  (let [opts (get parsed :options)
        subject (get opts :candidate (get opts :snapshot ""))
        reason (get opts :reason "no reason given")]
    (views--render-decline subject reason)))

(defn grove--run-handler [parsed]
  (let [opts (get parsed :options)
        config (get opts :provider-config "")]
    ;; ponytail: actual model-loop dispatch goes through libs/loom/agent.zio with the
    ;; provider config read from config-path; until the Loom + provider wiring
    ;; lands, the CLI rejects the command with the same error class the legacy
    ;; build returned without model-http.
    (error "invalid-input: run needs provider wiring; build with model provider enabled")))

;; ---------- Command handlers ----------
;; `serve` loads api.zio lazily: it is the one command that needs the
;; HTTP surface, and loading it at startup would read and compile the
;; router for every CLI invocation that never serves anything.
(defn grove--serve-handler [parsed]
  (let [opts (get parsed :options)
        bind (get opts :bind "127.0.0.1:8787")
        config (get parsed :launcher {})
        ;; `--root` wins over the launcher's `--app-root-dir` because it is
        ;; the operator's per-invocation decision; the launcher value stays
        ;; the default for the installed service.
        serve-root (if (= (get opts :root "") "") (get config :root "") (get opts :root))
        ;; Like the store root: argv's sibling `web` directory is the
        ;; default when the launcher did not grant a UI tree.
        config (if (= (get config :web-root "") "")
                 (assoc config :web-root (str serve-root "/web"))
                 config)]
    (load "api.zio")
    (api--check-bind bind (count (api--load-tokens)))
    (api--serve bind serve-root config)))

(defn grove--cli-handlers []
  {"demo" grove--demo-handler
   "inspect" grove--inspect-handler
   "checkpoint" grove--checkpoint-handler
   "fork" grove--fork-handler
   "resume" grove--resume-handler
   "compare" grove--compare-handler
   "select" grove--select-handler
   "approve" grove--approve-handler
   "decline" grove--decline-handler
   "run" grove--run-handler
   "serve" grove--serve-handler})

;; Help is answered before dispatch: `--help` on its own names no
;; command, and a dispatch that runs first would report "a command is
;; required" for the one input that is asking how the others work. The
;; note sits above the `let` because a comment inside the binding vector
;; ends the form.
;;
;; The launcher's config map carries the grants and defaults (`--app-bind`
;; and friends are launcher flags, not argv), so its values fill in the
;; options argv did not set. Argv wins: an explicit command-line flag is
;; the operator's per-invocation decision over a launcher default.
(defn grove--main [argv config]
  (let* [parsed (rill-parse grove--cli-spec argv)
         opts (reduce (fn [out key]
                        (if (nil? (get out key nil))
                          (assoc out key (get config key nil))
                          out))
                      (get parsed :options {})
                      (keys config))
         parsed (assoc parsed :options opts)
         parsed (assoc parsed :launcher config)
         result (if (get parsed :help)
                  (rill-help grove--cli-spec (get parsed :command))
                  (rill-dispatch parsed (grove--cli-handlers)))]
    result))