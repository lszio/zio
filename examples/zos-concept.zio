(println "=== ZOS Capability Probe ===")

(defclass point nil
  ((x :initarg :x)
   (y :initarg :y)))

(def p (make-instance point :x 10 :y 20))
(println "point-x:" (slot-value p :x))
(println "point-y:" (slot-value p :y))

(defgeneric describe (shape))
(defmethod describe ((shape point))
  (str "Point(" (slot-value shape :x) ", " (slot-value shape :y) ")"))

(println (describe p))

;; Inherited method: the only `describe` method is on `point`, called here
;; on a `circle` instance. Regression: dispatch used to see a name-only
;; class ref, so superclass methods were reported as "no applicable method".
(defclass circle (point)
  ((radius :initarg :radius)))

(def c (make-instance circle :x 1 :y 2 :radius 5))
(println "circle-via-point:" (describe c))

;; ── Chaining with -> ─────────────────────────────────────────

;; Method chaining is the threading macro over the ZOS call convention
;; (gf obj args): each step receives the previous value first.
(println "chained:" (-> p (slot-value :x) (+ 5)))
(println "chained-describe:" (-> c describe))
(println "ZOS capability probe completed.")
