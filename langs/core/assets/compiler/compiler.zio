;; Portable stack compiler. Reader and expansion are Zio; native hooks provide
;; value/source projections and VM mechanisms. Binding policy lives in analyze.zio.
;; State is persistent; local/capture indexes are selected here, never by the VM.
(defn zc-get [v i] (get v i nil))
(defn zc-tail [v n] (slice v n (count v)))
(defn zc-vset [v i x]
  (loop [j 0 out []]
    (if (= j (count v)) out
      (recur (+ j 1) (vector-conj out (if (= j i) x (get v j)))))))
(defn zc-fail [s message] (compiler/fail (get s :source-name) (get s :position) :invalid-form message))
(defn zc-check [s ok message] (if ok s (zc-fail s message)))
(defn zc-order [m] (compiler/order-keys m))
;; Strict syntax provenance: a form carries its own span first, and a
;; macro-generated node carries the call site of the expansion that made
;; it. Positions fall back in that order and no further.
(defn zc-position [raw]
  (let [direct (compiler/position raw)]
    (if direct direct
      (let [origin (if (map? raw) (get raw :origin nil) nil)
            site (if origin (get origin :call-site nil) nil)]
        (if (if site (get site :line nil) false)
          [(get site :line) (get site :col)] nil)))))
(defn zc-emit [s instruction]
  (put (put s :code (vector-conj (get s :code) instruction))
    :debug (vector-conj (get s :debug) (get s :position))))
;; A constant crosses the wire as a tagged record, not a bare literal: the
;; tag is what lets the runtime rebuild the value's exact kind, so a
;; keyword does not come back as a string. Composite literals are interned
;; into the module's own table and referenced by index, so the wire form
;; never carries a nested value and cannot grow without bound.
(defn zc-intern [s table x]
  (cond
    ((vector? x)
      (let [r (zc-intern-seq s table x)]
        (zc-intern-tag (first r) table {:kind :vector :value (second r)})))
    ((list? x)
      (let [r (zc-intern-seq s table x)]
        (zc-intern-tag (first r) table {:kind :list :value (second r)})))
    ((map? x)
      (let [r (zc-intern-pairs s table x)]
        (zc-intern-tag (first r) table {:kind :map :value (second r)})))
    (else (zc-intern-tag s table (zc-const-tag s x)))))
(defn zc-intern-tag [s table tag]
  (let [at (zc-const-find table tag)]
    (if at
      [s at]
      (let [i (count (get s :constants))]
        [(put s :constants (vector-conj (get s :constants) tag)) i]))))
(defn zc-const-find [table tag]
  (loop [i 0]
    (if (>= i (count table)) nil
      (if (= (first (get table i)) tag)
        (second (get table i))
        (recur (+ i 1))))))
(defn zc-intern-seq [s table x]
  (loop [i 0 state s indices []]
    (if (>= i (count x)) [state indices]
      (let [r (zc-intern state table (nth x i))]
        (recur (+ i 1) (first r) (vector-conj indices (second r)))))))
(defn zc-intern-pairs [s table x]
  (loop [ks (zc-order x) state s pairs []]
    (if (= (count ks) 0) [state pairs]
      (let [k (first ks)
            rk (zc-intern state table k)
            rv (zc-intern (first rk) table (get x k))]
        (recur (rest ks) (first rv) (vector-conj pairs [(second rk) (second rv)]))))))
(defn zc-const-tag [s x]
  (cond
    ((nil? x) {:kind :nil})
    ((boolean? x) {:kind :boolean :value x})
    ((integer? x) {:kind :integer :value x})
    ((float? x) {:kind :float :value (compiler/float-bits x)})
    ((string? x) {:kind :string :value x})
    ((symbol? x) {:kind :symbol :value (str x)})
    ((keyword? x) {:kind :keyword :value (compiler/name x)})
    ((char? x) {:kind :char :value (str x)})
    (else (zc-fail s (str "unsupported constant: " (str x))))))
(defn zc-constant [s x]
  (let [r (zc-intern s [] x)]
    (zc-emit (first r) [:const (second r)])))
(defn zc-patch [s i instruction] (put s :code (zc-vset (get s :code) i instruction)))
(defn zc-sequence [s forms tail]
  (if (= (count forms) 0) (zc-constant s nil)
    (loop [i 0 state (zc-reserve-forms s forms)]
      (let* [last (= (+ i 1) (count forms))
             next (zc-expr state (get forms i) (if last tail false))]
        (if last next (recur (+ i 1) (zc-emit next [:pop])))))))
(defn zc-many [s forms]
  (loop [i 0 state s]
    (if (= i (count forms)) state
      (recur (+ i 1) (zc-expr state (get forms i) false)))))
(defn zc-record [s]
  {:name (get s :name) :params (get s :params) :rest (get s :rest) :locals (get s :locals)
   :captures (get s :captures) :code (get s :code) :debug (get s :debug)})
(defn zc-function-mode [s name raw body depth]
  (let* [parsed (zc-params s raw)
         params (get parsed 0) rest (get parsed 1)
         plan (zc-capture-plan s)
         visible (get plan 0) captured (get plan 1) bindings (get plan 2)
         index (count (get s :functions))
         child (assoc s :code [] :debug [] :locals 0 :env bindings
                   :owned {} :forward {} :loop nil :depth depth
                   :params params :rest rest :name name
                   :captures (map (fn [k] (get visible k)) captured)
                   :functions (vector-conj (get s :functions) nil))
         ;; Parameters live AFTER this function's own captures, so the
         ;; first parameter starts at the capture count. Allocating from
         ;; zero would put the first parameter on top of the first
         ;; capture, and the body would read the captured value in place
         ;; of its own argument.
         capture-base (count captured)
         with-params (reduce (fn [state name] (zc-alloc state (symbol name)))
                         (put child :locals capture-base) params)
         with-rest (if rest (zc-alloc with-params (symbol rest)) with-params)
         compiled (zc-emit (zc-sequence with-rest body true) [:return])
         functions (zc-vset (get compiled :functions) index (zc-record compiled))
         parent (put (put s :functions functions) :constants (get compiled :constants))]
    (zc-emit parent [:closure index])))
(defn zc-function [s raw body] (zc-function-mode s nil raw body 1))
(defn zc-named-function [s name raw body] (zc-function-mode s name raw body 1))
(defn zc-if [s args tail]
  (zc-check s (if (= (count args) 2) true (= (count args) 3)) "if requires two or three arguments")
  (let* [test (zc-expr s (get args 0) false)
         false-index (count (get test :code))
         yes (zc-expr (zc-emit test [:jump-false 0]) (get args 1) tail)
         end-index (count (get yes :code))
         before-no (zc-emit yes [:jump 0])
         no-index (count (get before-no :code))
         no (zc-expr before-no (zc-get args 2) tail)]
    (zc-patch (zc-patch no false-index [:jump-false no-index]) end-index [:jump (count (get no :code))])))
(defn zc-short [s args tail mode]
  (if (= (count args) 0) (zc-constant s (if (= mode 'and) true nil))
    (if (= (count args) 1) (zc-expr s (get args 0) tail)
      (let* [first (zc-emit (zc-expr s (get args 0) false) [:dup])
             index (count (get first :code))
             branch (if (= mode 'and) :jump-false :jump-true)
             next (zc-short (zc-emit (zc-emit first [branch 0]) [:pop]) (zc-tail args 1) tail mode)]
        (zc-patch next index [branch (count (get next :code))])))))
(defn zc-cond [s args tail]
  ;; Lower clauses iteratively: rebuilding nested cond/if forms makes the
  ;; bootstrap compiler consume the Rust stack in proportion to clause count.
  (loop [i 0 state s exits []]
    (if (= i (count args))
      (let* [finished (zc-constant state nil) end (count (get finished :code))]
        (reduce (fn [out jump] (zc-patch out jump [:jump end])) finished exits))
      (let [clause (compiler/form (get args i))]
        (zc-check state (if (list? clause) (> (count clause) 0) false)
          "cond clause must be a nonempty list")
        (if (= (compiler/form (get clause 0)) 'else)
          (let* [finished (zc-sequence state (zc-tail clause 1) tail)
                 end (count (get finished :code))]
            (reduce (fn [out jump] (zc-patch out jump [:jump end])) finished exits))
          (let* [tested (zc-expr state (get clause 0) false)
                 false-index (count (get tested :code))
                 selected (zc-sequence (zc-emit tested [:jump-false 0]) (zc-tail clause 1) tail)
                 exit-index (count (get selected :code))
                 next (zc-emit selected [:jump 0])
                 patched (zc-patch next false-index [:jump-false (count (get next :code))])]
            (recur (+ i 1) patched (vector-conj exits exit-index))))))))
(defn zc-let [s args tail mode]
  (zc-check s (> (count args) 1) "let/loop requires bindings and body")
  ;; let/let* initializers are sequential; loop initializers all see the outer scope.
  (let* [scope (put (put (put (put s :env (zc-visible s)) :owned {}) :forward {})
                 :depth (+ (get s :depth) 1))
         prepared (if (= mode 'loop) scope (zc-reserve-forms scope (zc-tail args 1)))
         bound (zc-bindings prepared (get args 0) (not (= mode 'loop)) s)
         state (get bound 0) slots (get bound 1)
         start (count (get state :code))
         loop-frame {:start start :slots slots :catch-depth (get s :catch-depth 0)}
         inner (put state :loop (if (= mode 'loop) loop-frame (get s :loop)))
         compiled (zc-sequence inner (zc-tail args 1) (if (= mode 'loop) true tail))]
    (zc-scope compiled s)))
(defn zc-recur [s args tail]
  (let [frame (zc-recur-frame s tail)]
    (zc-check s (= (count args) (count (get frame :slots))) "recur argument count mismatch")
    (let* [evaluated (zc-many s args)
           unwound (loop [n (- (get s :catch-depth 0) (get frame :catch-depth 0)) state evaluated]
                     (if (= n 0) state (recur (- n 1) (zc-emit state [:clear-error]))))]
      (zc-emit (loop [i (- (count args) 1) state unwound]
                 (if (< i 0) state
                   (recur (- i 1) (zc-emit state [:bind (get (get frame :slots) i)]))))
               [:jump (get frame :start)]))))
(defn zc-def [s name expression]
  (zc-check s (symbol? name) "definition requires a symbol")
  (if (= (get s :depth) 0)
    (zc-emit (zc-expr s expression false) [:define (str name)])
    (let* [reserved (zc-reserve s name)
           binding (get (get reserved :owned) name (get (get reserved :forward) name nil))
           evaluated (zc-expr reserved expression false)]
      (zc-emit (zc-own evaluated name binding) [:store (get binding 1)]))))
(defn zc-set [s args]
  (zc-check s (= (count args) 2) "set! requires name and value")
  (let [name (compiler/datum (get args 0))]
    (zc-check s (symbol? name) "set! requires a symbol")
    (let* [evaluated (zc-expr s (get args 1) false)
           binding (get (get evaluated :env) name nil)]
      (if binding
        (zc-emit evaluated [(if (= (get binding 0) :local) :set-local :store-capture) (get binding 1)])
        (zc-emit evaluated [:set-global (str name)])))))
(defn zc-macro [s args]
  (zc-check s (> (count args) 1) "defmacro requires name and body")
  (let [name (compiler/datum (get args 0)) second (compiler/form (get args 1))]
    (zc-check s (symbol? name) "macro name must be a symbol")
    (if (if (list? second) (= (compiler/form (zc-get second 0)) 'syntax-rules) false)
      (let [rules (compiler/datum (get args 1))]
        (compiler/install-rules name rules)
        (zc-emit (zc-constant s rules) [:macro-rules (str name)]))
      (let* [checked (zc-check s (= (count (get s :env)) 0) "local macro declarations require explicit top-level bindings")
             compiled (zc-function checked (get args 1) (zc-tail args 2))
             index (get (get (get compiled :code) (- (count (get compiled :code)) 1)) 1)
             entry 0
             wrapper {:name nil :params [] :rest nil :locals 0 :captures []
                      :code [[:closure index] [:return]] :debug [(get s :position) (get s :position)]}
             artifact {:version 1 :name (get s :source-name) :entry entry :entry-name (str name)
                       :functions (reduce (fn [out record] (vector-conj out (if record record wrapper))) [] (get compiled :functions))
                       :constants (get compiled :constants)}]
        (compiler/install-macro name artifact)
        (zc-emit compiled [:macro (str name)])))))
(defn zc-try [s args tail]
  (zc-check s (> (count args) 0) "try requires a body")
  (let* [split (loop [i (count args)]
                (if (= i 0) i
                  (let [form (compiler/form (get args (- i 1)))]
                    (if (if (list? form) (= (compiler/form (zc-get form 0)) 'catch) false)
                      (recur (- i 1)) i))))
         catches (zc-tail args split)
         body (slice args 0 split)
         handler-index (count (get s :code))
         opened (zc-emit s [:handler []])
         success (zc-emit (zc-sequence opened body false) [:unhandler])
         jump-index (count (get success :code))
         initial (zc-emit success [:jump 0])
         handlers (loop [i (- (count catches) 1) state initial targets [] exits []]
                    (if (< i 0) [state targets exits]
                      (let* [clause (compiler/form (get catches i))
                             kind (compiler/datum (zc-get clause 1))
                             type-name (if (if (symbol? kind) true (keyword? kind)) (compiler/name kind) "any")
                             target (count (get state :code))
                             scope (put (put (put (put (put state :env (zc-visible state))
                                       :owned {}) :forward {}) :depth (+ (get s :depth) 1))
                                       :catch-depth (+ (get s :catch-depth 0) 1))
                             handled (zc-emit
                                       (put (zc-scope
                                         (zc-sequence scope (if (> (count clause) 2) (zc-tail clause 2) []) tail) state)
                                         :catch-depth (get s :catch-depth 0)) [:clear-error])
                             exit (count (get handled :code))]
                        (recur (- i 1) (zc-emit handled [:jump 0])
                          (vector-conj targets [type-name target]) (vector-conj exits exit)))))
         result (get handlers 0) end (count (get result :code))
         patched (reduce (fn [state i] (zc-patch state i [:jump end])) result (get handlers 2))]
    (zc-patch (zc-patch patched handler-index [:handler (get handlers 1)]) jump-index [:jump end])))
(defn zc-metadata [s op args]
  (zc-emit (zc-constant s (compiler/datum (apply list args))) [:metadata (compiler/name op)]))
(defn zc-module [s args]
  (zc-check s (> (count args) 0) "module requires a name")
  (let* [explicit (= (compiler/datum (zc-get args 1)) :export)
         exports (if explicit (compiler/datum (get args 2)) [])
         start (if explicit 3 1)
         compiled (zc-function-mode s nil [] (zc-tail args start) 0)]
    (zc-emit (zc-constant (zc-constant compiled (compiler/datum (get args 0))) exports) [:module])))
(defn zc-method [s args]
  (zc-check s (> (count args) 2) "defmethod requires name, specializers and body")
  (let* [qualified (keyword? (compiler/datum (get args 1)))
         index (if qualified 2 1)
         specs (compiler/datum (get args index))
         params (map (fn [spec] (if (symbol? spec) spec (get spec 0))) specs)
         compiled (zc-function s params (zc-tail args (+ index 1)))
         metadata (slice args 0 (+ index 1))]
    (zc-emit (zc-constant compiled (compiler/datum (apply list metadata))) [:method])))
(defn zc-class [s args]
  (zc-check s (> (count args) 2) "defclass requires name, supers and slots")
  (zc-emit (zc-constant s (compiler/datum (apply list args))) [:class 0]))
(defn zc-quasi-seq [s items depth as-list]
  (let [compiled
        (loop [i 0 state (zc-emit s [:vector 0])]
          (if (= i (count items)) state
            (let* [raw (get items i)
                   wrapped (zc-wrapper raw)
                   splice (if (= depth 1)
                            (if wrapped (= (get wrapped 0) 'unquote-splicing) false) false)
                   evaluated (if splice (zc-expr state (get wrapped 1) false)
                               (zc-quasi state raw depth))]
              (recur (+ i 1) (zc-emit evaluated [:quasi-conj splice])))))]
    (if as-list (zc-emit compiled [:quasi-list]) compiled)))
(defn zc-quasi [s raw depth]
  (let* [position (zc-position raw)
         located (if position (put s :position position) s)
         x (compiler/form raw)
         wrapped (zc-wrapper raw)]
    (if wrapped
      (let [op (get wrapped 0) inner (get wrapped 1)]
        (cond
          ((if (= op 'unquote) (= depth 1) false) (zc-expr located inner false))
          ((if (= op 'unquote-splicing) (= depth 1) false)
            (zc-fail located "unquote-splicing outside of a list or vector template"))
          (else
            (let* [head (zc-emit (zc-constant (zc-emit located [:vector 0]) op) [:quasi-conj false])
                   nested (zc-quasi head inner (if (= op 'quasiquote) (+ depth 1) (- depth 1)))]
              (zc-emit (zc-emit nested [:quasi-conj false]) [:quasi-list])))))
      (cond
        ((list? x) (zc-quasi-seq located x depth true))
        ((vector? x) (zc-quasi-seq located x depth false))
        ((map? x)
          (let [ks (zc-order x)]
            (zc-emit (reduce (fn [state k]
                              (zc-quasi (zc-quasi state k depth) (get x k) depth)) located ks)
              [:map (count ks)])))
        (else (zc-constant located (compiler/datum raw)))))))
(defn zc-defn [s args]
  (zc-check s (> (count args) 2) "defn requires name, params and body")
  (let [name (compiler/datum (get args 0))]
    (zc-check s (symbol? name) "defn requires a symbol")
    (if (= (get s :depth) 0)
      (zc-emit (zc-named-function s (str name) (get args 1) (zc-tail args 2)) [:define (str name)])
      (let* [reserved (zc-reserve s name)
             binding (get (get reserved :owned) name (get (get reserved :forward) name nil))
             compiled (zc-named-function reserved (str name) (get args 1) (zc-tail args 2))]
        (zc-emit (zc-own compiled name binding) [:store (get binding 1)])))))
;; One-step expansion through the real Zi expander. The descriptor comes
;; from the live environment, so compiled procedural macros, interpreted
;; macro bodies and syntax-rules all expand through zi-expand itself.
(defn zc-expand-once [x]
  (if (map? x)
    (let [children (get x :children nil)]
      (if (if (vector? children) (> (count children) 0) false)
        (let [head (get children 0)]
          (if (= (get head :kind nil) :symbol)
            (let* [found (interpreter/env :lookup 0 (get head :value))
                   descriptor (if (get found 0) (interpreter/callable-info (get found 1)) nil)]
              (if (if descriptor (= (get descriptor :kind nil) :macro) false)
                (zi-expand descriptor (zc-tail children 1) x)
                x))
            x))
        x))
    x))
(defn zc-expand [s x]
  (loop [current x n 0]
    (do
      (zc-check s (< n 1024) "macro expansion limit exceeded")
      (let [next (zc-expand-once current)]
        (if (= next current) current (recur next (+ n 1)))))))
(defn zc-expr [s raw tail]
  (let* [position (zc-position raw)
         located (if position (put s :position position) s)
         form (compiler/form raw)
         x (if (list? form) (compiler/form (zc-expand located raw)) form)]
    (cond
      ((symbol? x) (zc-load located x))
      ((vector? x) (zc-emit (zc-many located x) [:vector (count x)]))
      ((map? x) (let [ks (zc-order x)]
                   (zc-emit (reduce (fn [state k] (zc-expr (zc-expr state k false) (get x k) false)) located ks)
                     [:map (count ks)])))
      ((list? x)
        (if (= (count x) 0) (zc-constant located nil)
          (let [op (compiler/form (get x 0)) args (zc-tail x 1)]
            (cond
              ((= op 'quote) (do (zc-check located (= (count args) 1) "quote requires one argument") (zc-constant located (compiler/datum (get args 0)))))
              ((= op 'quasiquote) (do (zc-check located (= (count args) 1) "quasiquote requires one argument") (zc-quasi located (get args 0) 1)))
              ((= op 'if) (zc-if located args tail))
              ((= op 'do) (zc-sequence located args tail))
              ((= op 'fn) (zc-function located (get args 0) (zc-tail args 1)))
              ((= op 'def) (do (zc-check located (= (count args) 2) "def requires two arguments") (zc-def located (compiler/datum (get args 0)) (get args 1))))
              ((= op 'defn) (zc-defn located args))
              ((= op 'set!) (zc-set located args))
              ((= op 'let) (zc-let located args tail op))
              ((= op 'let*) (zc-let located args tail op))
              ((= op 'loop) (zc-let located args tail op))
              ((= op 'recur) (zc-recur located args tail))
              ((= op 'and) (zc-short located args tail op))
              ((= op 'or) (zc-short located args tail op))
              ((= op 'cond) (zc-cond located args tail))
              ((= op 'defmacro) (zc-macro located args))
              ((= op 'try) (zc-try located args tail))
              ((= op 'module) (zc-module located args))
              ((= op 'require) (zc-metadata located :require args))
              ((= op 'export) (zc-metadata located :export args))
              ((= op 'defpackage) (zc-metadata located :package args))
              ((= op 'defgeneric) (zc-metadata located :generic args))
              ((= op 'defclass) (zc-class located args))
              ((= op 'defmethod) (zc-method located args))
              ((= op 'call-next-method) (zc-emit (put (zc-many (zc-emit located [:global "*next-method*"]) args) :position (get located :position)) [(if tail :tail-call :call) (count args)]))
              (else (zc-emit (put (zc-many (zc-expr located (get x 0) false) args) :position (get located :position)) [(if tail :tail-call :call) (count args)]))))))
      (else (zc-constant located x)))))
(defn zio--compile [name forms]
  (let* [state {:name name :source-name name :position nil :code [] :debug [] :locals 0 :env {}
               :owned {} :forward {} :depth 0 :loop nil :params [] :rest nil :captures []
               :functions [nil] :constants []}
         compiled (zc-emit (zc-sequence state forms false) [:return])
         functions (zc-vset (get compiled :functions) 0 (zc-record compiled))]
    {:version 1 :name name :entry 0 :entry-name "zio--compile"
     :functions functions :constants (get compiled :constants)}))
