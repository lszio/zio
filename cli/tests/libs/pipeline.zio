;; lib/zio/pipeline.zio contract — pipeline DSL expands to plain Zio.
(load "lib/zio/pipeline.zio")

(defn check [label actual expected]
  (if (= actual expected)
    (println "PASS" label)
    (println "FAIL" label "got:" actual "want:" expected)))

(def nums [1 2 3 4 5 6])

(def doubled (pipeline nums
  (filter (fn [x] (> x 2)))
  (map (fn [x] (* x 10)))))
(check "filter-map" doubled (list 30 40 50 60))

(def n (pipeline nums (filter (fn [x] (> x 2))) (aggregate count)))
(check "aggregate-count" n 4)

;; the expansion is plain, readable Zio — pinned so it stays stable
(def expansion (macroexpand-1 (quote (pipeline nums (filter (fn [x] (> x 2))) (map (fn [x] (* x 10)))))))
(check "expansion-shape" expansion
       (quote (map (fn [x] (* x 10)) (filter (fn [x] (> x 2)) nums))))

;; unknown stage embeds an error call — fires if the pipeline runs
(def bad (macroexpand-1 (quote (pipeline nums (frobnicate 1)))))
(check "unknown-stage-detected" (str-contains? (str bad) "unknown pipeline stage") true)
